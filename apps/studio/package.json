{
  "name": "@apps/studio",
  "version": "0.1.0",
  "description": "WoW Lab web application (Next.js)",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm sync:wasm",
    "predev": "pnpm sync:wasm",
    "build": "dotenv -e .env.cloudflare -- velite build --clean && dotenv -e .env.cloudflare -- next build",
    "cf:build": "dotenv -e .env.cloudflare -- opennextjs-cloudflare build && zx scripts/check-cloudflare-artifact.mts",
    "cf:build:dev": "dotenv -e .env.cloudflare.dev -- opennextjs-cloudflare build && zx scripts/check-cloudflare-artifact.mts",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev --port 3000",
    "dev:content": "dotenv -e .env.local -- zx scripts/dev-content.mts",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "generate": "intlayer build && velite build --clean && next typegen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ncu": "ncu -u",
    "start": "next start",
    "sync:wasm": "zx scripts/sync-wasm.mts",
    "test": "vitest run && pnpm check:ui-coverage",
    "typecheck": "tsc --noEmit",
    "check:ui-coverage": "zx scripts/check-ui-coverage.mts"
  },
  "dependencies": {
