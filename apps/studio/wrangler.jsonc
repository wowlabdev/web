{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wowlab-studio",
  "account_id": "3be81982f71345d4861aa17bd26f0023",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,
  "upload_source_maps": true,
  "keep_names": false,
  "routes": [{ "pattern": "app.wowlab.gg", "custom_domain": true }],
  "vars": {
    "OPEN_NEXT_REQUEST_ID_HEADER": "1",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "wowlab-studio",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "wowlab-studio-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "tail_consumers": [{ "service": "wowlab-tail" }],
  "env": {
    "dev": {
      "name": "wowlab-studio-dev",
      "keep_names": false,
      "routes": [{ "pattern": "app.dev.wowlab.gg", "custom_domain": true }],
      "vars": {
        "OPEN_NEXT_REQUEST_ID_HEADER": "1",
      },
      "assets": {
        "binding": "ASSETS",
        "directory": ".open-next/assets",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "wowlab-studio-dev",
        },
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "wowlab-studio-dev-cache",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
          {
            "name": "NEXT_TAG_CACHE_DO_SHARDED",
            "class_name": "DOShardedTagCache",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
        },
      ],
      "observability": {
        "enabled": true,
      },
      "tail_consumers": [{ "service": "wowlab-tail-dev" }],
    },
  },
}
