{
  "name": "@apps/landing",
  "version": "0.1.0",
  "description": "WoW Lab marketing/landing site (Next.js)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "dotenv -e .env.cloudflare -- velite build --clean && dotenv -e .env.cloudflare -- next build",
    "cf:build": "dotenv -e .env.cloudflare -- opennextjs-cloudflare build",
    "cf:build:dev": "dotenv -e .env.cloudflare.dev -- opennextjs-cloudflare build",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev --port 3001",
    "dev:content": "dotenv -e .env.local -- zx scripts/dev-content.mts",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "generate": "intlayer build && velite build --clean && next typegen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ncu": "ncu -u",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wowlab/shared": "workspace:*",
    "ahooks": "catalog:",
    "date-fns": "catalog:",
    "intlayer": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "next-intlayer": "catalog:",
    "next-seo": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "catalog:",
    "@shikijs/transformers": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@types/hast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wowlab/eslint-config": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv-cli": "catalog:",
    "entities": "catalog:",
    "eslint": "catalog:",
    "feed": "catalog:",
    "fluid-tailwindcss": "catalog:",
    "hast-util-to-string": "catalog:",
    "rehype-pretty-code": "catalog:",
    "rehype-slug": "catalog:",
    "shiki": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unist-util-visit": "catalog:",
    "velite": "catalog:",
    "wrangler": "catalog:",
    "zx": "catalog:"
  }
}
